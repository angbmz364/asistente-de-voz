# LLM Provider Selection
# Set to 'gemini' for Gemini API or 'ollama' for local Ollama inference
# Default: gemini
VITE_LLM_PROVIDER=gemini

# ============================================
# Gemini API Configuration
# ============================================
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_GEMINI_MAX_TOKENS=800

# ============================================
# Ollama Local Inference Configuration
# ============================================
# VITE_LLM_PROVIDER=ollama
VITE_OLLAMA_ENDPOINT=http://localhost:11434
VITE_OLLAMA_MODEL=gemma3:4b
VITE_OLLAMA_MAX_TOKENS=200

# Speech-to-text provider selection
# Set to 'browser' to use the browser SpeechRecognition API (default)
# Set to 'faster-whisper' to use a local Faster-Whisper service
VITE_STT_PROVIDER=browser

# If using Faster-Whisper, point to the local server endpoint
VITE_STT_SERVER_ENDPOINT=http://localhost:11435
